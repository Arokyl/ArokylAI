{
  "name": "@somnia-agent/contracts",
  "version": "1.0.0",
  "private": true,
"scripts": {
      "build":      "forge build",
      "test":       "forge test -vvv",
      "fuzz":       "forge test --fuzz-runs 5000",
      "deploy":     "forge script script/Deploy.s.sol --broadcast --verify",
      "deploy:monad": "forge script script/Deploy.s.sol:Deploy --rpc-url monad --chain-id 10143 --broadcast",
      "deploy:arc":   "forge script script/Deploy.s.sol:Deploy --rpc-url arc --chain-id 13371 --broadcast",
      "deploy:direct:monad": "forge script script/DeployDirect.s.sol:DeployDirect --rpc-url monad --chain-id 10143 --broadcast",
      "deploy:direct:arc":   "forge script script/DeployDirect.s.sol:DeployDirect --rpc-url arc --chain-id 13371 --broadcast",
      "lint":       "forge fmt --check",
      "format":     "forge fmt",
      "size":       "forge build --sizes",
      "slither":    "slither src/",
      "packageManager": "pnpm@9.0.0"
    }
}
